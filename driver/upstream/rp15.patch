+static const unsigned int uniwill_kbd_channel_to_reg[] = {
+	EC_ADDR_RGB_RED,
+	EC_ADDR_RGB_GREEN,
+	EC_ADDR_RGB_BLUE,
+};
+
+static int uniwill_kbd_write_brightness(struct uniwill_data *data, unsigned int brightness)
+{
+	/* Always write, the EC might not clear the apply bit on its own */
+	return regmap_write_bits(data->regmap, EC_ADDR_KBD_STATUS, KBD_BRIGHTNESS | KBD_APPLY,
+				 FIELD_PREP(KBD_BRIGHTNESS, brightness) | KBD_APPLY);
+}
+
+static int uniwill_kbd_write_color(struct uniwill_data *data, bool force)
+{
+	unsigned int color[LED_CHANNELS];
+	bool changed = force;
+	int ret;
+
+	/* The LED core does not bound intensity values */
+	for (int i = 0; i < LED_CHANNELS; i++) {
+		color[i] = min(KBD_MAX_INTENSITY, data->kbd_subled_info[i].intensity);
+		if (color[i] != data->kbd_last_color[i])
+			changed = true;
+	}
+
+	if (!changed)
+		return 0;
+
+	for (int i = 0; i < LED_CHANNELS; i++) {
+		ret = regmap_write(data->regmap, uniwill_kbd_channel_to_reg[i], color[i]);
+		if (ret < 0)
+			return ret;
+	}
+
+	ret = regmap_write_bits(data->regmap, EC_ADDR_TRIGGER, RGB_APPLY_COLOR, RGB_APPLY_COLOR);
+	if (ret < 0)
+		return ret;
+
+	for (int i = 0; i < LED_CHANNELS; i++)
+		data->kbd_last_color[i] = color[i];
+
+	return 0;
+}
+
+static int uniwill_kbd_apply(struct uniwill_data *data, unsigned int brightness, bool force)
+{
+	bool black = true;
+	int ret;
+
+	for (int i = 0; i < LED_CHANNELS; i++) {
+		if (min(KBD_MAX_INTENSITY, data->kbd_subled_info[i].intensity))
+			black = false;
+	}
+
+	/*
+	 * Writing an all-zero color makes the EC load its default color instead,
+	 * so treat black as "off" and leave the stored color alone.
+	 */
+	if (black)
+		return uniwill_kbd_write_brightness(data, 0);
+
+	ret = uniwill_kbd_write_color(data, force);
+	if (ret < 0)
+		return ret;
+
+	return uniwill_kbd_write_brightness(data, brightness);
+}
+
+static int uniwill_kbd_brightness_set(struct led_classdev *led_cdev, enum led_brightness brightness)
+{
+	struct led_classdev_mc *led_mc_cdev = lcdev_to_mccdev(led_cdev);
+	struct uniwill_data *data = container_of(led_mc_cdev, struct uniwill_data, kbd_mc_cdev);
+
+	guard(mutex)(&data->kbd_lock);
+
+	return uniwill_kbd_apply(data, brightness, false);
+}
+
+/*
+ * In manual mode the EC still tracks the backlight level when the user presses
+ * the brightness keys and reports the new level, but leaves applying it to us.
+ */
+static void uniwill_kbd_level_event(struct uniwill_data *data, unsigned int level)
+{
+	struct led_classdev *led_cdev = &data->kbd_mc_cdev.led_cdev;
+	int ret;
+
+	ret = led_set_brightness_sync(led_cdev, level);
+	if (ret < 0) {
+		dev_err(data->dev, "Failed to apply keyboard backlight level %u: %d\n", level, ret);
+		return;
+	}
+
+	led_classdev_notify_brightness_hw_changed(led_cdev, level);
+}
+
+static int uniwill_kbd_init(struct uniwill_data *data)
+{
+	struct led_init_data init_data = {
+		.devicename = DRIVER_NAME,
+		.default_label = ":" LED_FUNCTION_KBD_BACKLIGHT,
+	};
+	unsigned int color_indices[3] = {
+		LED_COLOR_ID_RED,
+		LED_COLOR_ID_GREEN,
+		LED_COLOR_ID_BLUE,
+	};
+	bool out_of_range = false;
+	unsigned int value;
+	int ret;
+
+	if (!uniwill_device_supports(data, UNIWILL_FEATURE_KBD_RGB))
+		return 0;
+
+	ret = devm_mutex_init(data->dev, &data->kbd_lock);
+	if (ret < 0)
+		return ret;
+
+	/* Start from whatever the EC currently shows, so loading is invisible */
+	ret = regmap_read(data->regmap, EC_ADDR_KBD_STATUS, &value);
+	if (ret < 0)
+		return ret;
+
+	data->kbd_mc_cdev.led_cdev.color = LED_COLOR_ID_MULTI;
+	data->kbd_mc_cdev.led_cdev.max_brightness = KBD_MAX_BRIGHTNESS;
+	data->kbd_mc_cdev.led_cdev.brightness = min(KBD_MAX_BRIGHTNESS,
+						    FIELD_GET(KBD_BRIGHTNESS, value));
+	/* Keep the backlight as-is on unload, the EC takes over the keys again */
+	data->kbd_mc_cdev.led_cdev.flags = LED_REJECT_NAME_CONFLICT | LED_BRIGHT_HW_CHANGED |
+					   LED_RETAIN_AT_SHUTDOWN;
+	data->kbd_mc_cdev.led_cdev.brightness_set_blocking = uniwill_kbd_brightness_set;
+
+	for (int i = 0; i < LED_CHANNELS; i++) {
+		ret = regmap_read(data->regmap, uniwill_kbd_channel_to_reg[i], &value);
+		if (ret < 0)
+			return ret;
+
+		/*
+		 * Remember the raw value: if the firmware left something out of
+		 * range here, the first color write must not be skipped.
+		 */
+		data->kbd_last_color[i] = value;
+		if (value > KBD_MAX_INTENSITY)
+			out_of_range = true;
+		data->kbd_subled_info[i].color_index = color_indices[i];
+		data->kbd_subled_info[i].intensity = min(KBD_MAX_INTENSITY, value);
+		data->kbd_subled_info[i].channel = i;
+	}
+
+	data->kbd_mc_cdev.subled_info = data->kbd_subled_info;
+	data->kbd_mc_cdev.num_colors = LED_CHANNELS;
+
+	/*
+	 * The firmware sometimes leaves out-of-range values behind after boot,
+	 * which the EC then renders as a random color on the next brightness
+	 * change. Write the clamped color once so that the EC and the LED agree.
+	 */
+	if (out_of_range) {
+		ret = uniwill_kbd_write_color(data, true);
+		if (ret < 0)
+			return ret;
+	}
+
+	return devm_led_classdev_multicolor_register_ext(data->dev, &data->kbd_mc_cdev,
+							 &init_data);
+}
