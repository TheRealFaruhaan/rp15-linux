+static int uniwill_profile_probe(void *drvdata, unsigned long *choices)
+{
+	set_bit(PLATFORM_PROFILE_LOW_POWER, choices);
+	set_bit(PLATFORM_PROFILE_BALANCED, choices);
+	set_bit(PLATFORM_PROFILE_PERFORMANCE, choices);
+
+	return 0;
+}
+
+static int uniwill_profile_get(struct device *dev, enum platform_profile_option *profile)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, &value);
+	if (ret < 0)
+		return ret;
+
+	switch (value & PERF_MODE_MASK) {
+	case PERF_MODE_OFFICE:
+		*profile = PLATFORM_PROFILE_LOW_POWER;
+		break;
+	case PERF_MODE_BEAST:
+		*profile = PLATFORM_PROFILE_PERFORMANCE;
+		break;
+	default:
+		*profile = PLATFORM_PROFILE_BALANCED;
+		break;
+	}
+
+	return 0;
+}
+
+static int uniwill_profile_set(struct device *dev, enum platform_profile_option profile)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+
+	switch (profile) {
+	case PLATFORM_PROFILE_LOW_POWER:
+		value = PERF_MODE_OFFICE;
+		break;
+	case PLATFORM_PROFILE_BALANCED:
+		value = PERF_MODE_GAMING;
+		break;
+	case PLATFORM_PROFILE_PERFORMANCE:
+		value = PERF_MODE_BEAST;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	/* Keep fan boost and the fan level bits as they are */
+	return regmap_update_bits(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, PERF_MODE_MASK, value);
+}
+
+static const struct platform_profile_ops uniwill_profile_ops = {
+	.probe = uniwill_profile_probe,
+	.profile_get = uniwill_profile_get,
+	.profile_set = uniwill_profile_set,
+};
+
+static int uniwill_perf_init(struct uniwill_data *data)
+{
+	unsigned int value;
+	bool empty = true;
+	int ret;
+
+	if (!uniwill_device_supports(data, UNIWILL_FEATURE_PERF_MODES))
+		return 0;
+
+	/*
+	 * Office mode drives the fans from the manual level table. If nothing
+	 * has filled it in yet, seed it with the EC's own default curve so that
+	 * the fans can never end up at 0% in that mode.
+	 */
+	for (int i = 0; i < FAN_LEVEL_COUNT; i++) {
+		ret = regmap_read(data->regmap, EC_ADDR_FAN_LEVELS + i, &value);
+		if (ret < 0)
+			return ret;
+		if (value)
+			empty = false;
+	}
+
+	if (empty) {
+		for (int i = 0; i < FAN_LEVEL_COUNT; i++) {
+			ret = regmap_read(data->regmap, EC_ADDR_FAN_DEFAULT + i, &value);
+			if (ret < 0)
+				return ret;
+			if (!value)
+				return -ENODEV;
+			ret = regmap_write(data->regmap, EC_ADDR_FAN_LEVELS + i, value);
+			if (ret < 0)
+				return ret;
+		}
+	}
+
+	data->ppdev = devm_platform_profile_register(data->dev, DRIVER_NAME, data,
+						     &uniwill_profile_ops);
+
+	return PTR_ERR_OR_ZERO(data->ppdev);
+}
