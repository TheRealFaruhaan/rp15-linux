+static ssize_t fan_boost_store(struct device *dev, struct device_attribute *attr, const char *buf,
+			       size_t count)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret < 0)
+		return ret;
+
+	/* Both fans run at full speed while set, independent of the mode */
+	ret = regmap_update_bits(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, FAN_MODE_BOOST,
+				 enable ? FAN_MODE_BOOST : 0);
+	if (ret < 0)
+		return ret;
+
+	return count;
+}
+
+static ssize_t fan_boost_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, &value);
+	if (ret < 0)
+		return ret;
+
+	return sysfs_emit(buf, "%d\n", !!(value & FAN_MODE_BOOST));
+}
+
+static DEVICE_ATTR_RW(fan_boost);
+
+/* Power limits in W, 0 means "no override" (firmware default, about 30 W sustained) */
+static ssize_t uniwill_pl_store(struct device *dev, const char *buf, size_t count,
+				unsigned int reg, unsigned int max)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &value);
+	if (ret < 0)
+		return ret;
+
+	if (value > max)
+		return -EINVAL;
+
+	ret = regmap_write(data->regmap, reg, value);
+	if (ret < 0)
+		return ret;
+
+	return count;
+}
+
+static ssize_t uniwill_pl_show(struct device *dev, char *buf, unsigned int reg)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(data->regmap, reg, &value);
+	if (ret < 0)
+		return ret;
+
+	return sysfs_emit(buf, "%u\n", value);
+}
+
+#define UNIWILL_PL_ATTR(_name, _reg, _max)						\
+static ssize_t _name##_store(struct device *dev, struct device_attribute *attr,		\
+			     const char *buf, size_t count)				\
+{											\
+	return uniwill_pl_store(dev, buf, count, _reg, _max);				\
+}											\
+static ssize_t _name##_show(struct device *dev, struct device_attribute *attr, char *buf)	\
+{											\
+	return uniwill_pl_show(dev, buf, _reg);						\
+}											\
+static DEVICE_ATTR_RW(_name)
